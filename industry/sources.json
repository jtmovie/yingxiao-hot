{
  "$comment": "营销行业首批信源：首次启动时导入（scripts/seed.ts），已存在的不会被覆盖。之后在后台“信源”里新建、修改和暂停。字段说明见 docs/customize.md。网页列表的选择器 2026-10-05 用 AIHOT 的预览代码实测过；公众号信源（需 DAJIALA_KEY 和公众号原始 ID）不在这里，上线后在后台添加。",
  "sources": [
    {
      "id": "rss-digitaling",
      "name": "数英 DIGITALING",
      "kind": "rss",
      "config": {
        "feedUrl": "https://www.digitaling.com/rss",
        "_aihot": {
          "initialBackfillLimit": 10
        }
      },
      "tier": "T2",
      "participation_mode": "editorial",
      "interval_minutes": 60,
      "tags": [
        "媒体",
        "创意案例"
      ],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
    {
      "id": "web-socialbeta",
      "name": "SocialBeta",
      "kind": "web_list",
      "config": {
        "url": "https://socialbeta.com",
        "parseMode": "html",
        "itemSelector": "div.con:has(> div.tit > a)",
        "linkSelector": "div.tit a",
        "titleSelector": "div.tit a",
        "allowUrlPrefixes": [
          "https://socialbeta.com/campaign/",
          "https://socialbeta.com/article/"
        ],
        "detail": {
          "maxFetches": 10,
          "publishedAtRegex": "/user/\\d+\">[^<]*</a>\\s*·\\s*(\\d{4}-\\d{2}-\\d{2})",
          "publishedAtAuthoritative": true
        },
        "_aihot": {
          "initialBackfillLimit": 10
        }
      },
      "tier": "T2",
      "participation_mode": "editorial",
      "interval_minutes": 60,
      "tags": [
        "媒体",
        "品牌营销"
      ],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
    {
      "id": "web-adquan",
      "name": "广告门",
      "kind": "web_list",
      "config": {
        "url": "https://www.adquan.com",
        "parseMode": "html",
        "itemSelector": "div.latestArticle > div.article_1",
        "linkSelector": "a[href*='/article/']",
        "titleSelector": "a.article_2_href",
        "allowUrlPrefixes": [
          "https://www.adquan.com/article/"
        ],
        "detail": {
          "maxFetches": 10,
          "publishedAtSelector": "p.time",
          "publishedAtAuthoritative": true
        },
        "_aihot": {
          "initialBackfillLimit": 10
        }
      },
      "tier": "T2",
      "participation_mode": "editorial",
      "interval_minutes": 60,
      "tags": [
        "媒体",
        "行业动态"
      ],
      "site_fulltext": false,
      "syndicate_fulltext": false
    },
    {
      "id": "web-morketing",
